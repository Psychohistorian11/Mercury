{
    "compilerOptions": {
        "target": "ES2021",
        "module": "commonjs",
        "lib": [
            "ES2021",
            "DOM"
        ],
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "skipLibCheck": true,
        "types": [
            "@serenity-js/core",
            "@cucumber/cucumber"
        ]
    },
    "include": [
        "features/**/*.ts"
    ]
}